# OpenSearch Image
OS_IMAGE=ca417aedc7df
 

# Node Names
OS_NODE1_NAME=opensearch-node1
OS_NODE2_NAME=opensearch-node2
OS_NODE3_NAME=opensearch-node3
OS_NODE4_NAME=opensearch-node4
OS_NODE5_NAME=opensearch-node5
OS_NODE6_NAME=opensearch-node6
OS_NODE7_NAME=opensearch-node7
OS_NODE8_NAME=opensearch-node8

# Network
OS_NETWORK_NAME=opensearch-net

# Ports
OS_HTTP_PORT=9200
OS_PERF_PORT=9600

# Security
OS_PASSWORD=admin

# Additional required variables
SECURITY_DISABLED=true
CLUSTER_NAME=opensearch-cluster
JAVA_OPTS="-Xms512m -Xmx512m"
OS_CONFIG_FILE=./config/config.yml
OS_FSREPO_PATH=./fsrepo
